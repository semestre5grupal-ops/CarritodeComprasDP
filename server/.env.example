# ============================================
# Shop Sport Backend — Variables de Entorno
# ============================================
# Copia este archivo como .env y completa los valores

# Puerto del servidor Express
PORT=4000

# Entorno: development | production | test
NODE_ENV=development

# Base de Datos SQL Server (Autenticación de Windows)
# Si usa autenticación por usuario/contraseña, cambie 'integratedSecurity=true' por 'user=su_usuario;password=su_password'
DATABASE_URL="sqlserver://localhost:1433;database=ShopSportDB;integratedSecurity=true;trustServerCertificate=true;"

# JWT
JWT_SECRET="cambia-este-secret-por-uno-seguro-y-largo-aqui"
JWT_EXPIRES_IN="8h"

# CORS — Origen(es) permitido(s) para el frontend (separados por coma si son varios)
CORS_ORIGIN="http://localhost:5173,http://localhost:5500"

# Nivel de log: dev | combined | short
LOG_LEVEL=dev
