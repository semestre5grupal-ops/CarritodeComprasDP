# ============================================
# Shop Sport Backend — Variables de Entorno
# ============================================
# Copia este archivo como .env y completa los valores

# Puerto del servidor Express
PORT=4000

# Entorno: development | production | test
NODE_ENV=development

# Base de Datos SQL Server (cadena de conexión Prisma)
# Formato: sqlserver://HOST:PORT;database=DB_NAME;user=USER;password=PASS;trustServerCertificate=true
DATABASE_URL="sqlserver://localhost:1433;database=ShopSportDB;user=sa;password=TuPassword123;trustServerCertificate=true"

# JWT
JWT_SECRET="cambia-este-secret-por-uno-seguro-y-largo-aqui"
JWT_EXPIRES_IN="8h"

# CORS — Origen(es) permitido(s) para el frontend (separados por coma si son varios)
CORS_ORIGIN="http://localhost:5173,http://localhost:5500"

# Nivel de log: dev | combined | short
LOG_LEVEL=dev
