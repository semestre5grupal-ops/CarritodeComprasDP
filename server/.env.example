# ============================================
# Shop Sport Backend — Variables de Entorno
# ============================================
# Copia este archivo como .env y completa los valores

# Puerto del servidor Express
PORT=4000

# Entorno: development | production | test
NODE_ENV=development

# Base de Datos PostgreSQL (local) - Ajusta usuario, contraseña y host según tu instancia local
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ShopSportDB?schema=public"

# JWT
JWT_SECRET="cambia-este-secret-por-uno-seguro-y-largo-aqui"
JWT_EXPIRES_IN="8h"

# CORS — Origen(es) permitido(s) para el frontend (separados por coma si son varios)
CORS_ORIGIN="http://localhost:5173,http://localhost:5500"

# Nivel de log: dev | combined | short
LOG_LEVEL=dev
