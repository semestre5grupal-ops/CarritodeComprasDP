generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ajustes {
  id_ajuste           Int       @id(map: "pk_ajustes") @default(autoincrement())
  id_bodega           Int
  aju_fechahora       DateTime  @db.Date
  aju_descripcion     String    @db.VarChar(150)
  aju_fecharesolucion DateTime? @db.Date
  aju_num_produc_     Int
  usu_responsable     String    @db.VarChar(150)
  aju_estado          String    @db.VarChar(150)
  bodega              bodega    @relation(fields: [id_bodega], references: [id_bodega], onUpdate: Restrict, map: "fk_ajustes_ajsuta_en_bodega")
  proxaju             proxaju[]

  @@index([id_bodega], map: "ajsuta_en_fk")
}

model asientos {
  id_asientocontable3 String            @id(map: "pk_asientos") @db.VarChar(150)
  asi_fechahora       DateTime          @db.Date
  asi_descripcion     String            @db.VarChar(150)
  asi_estadoasiento   String            @db.VarChar(150)
  asi_total_debe      Decimal           @db.Decimal(7, 2)
  asi_total_haber     Decimal           @db.Decimal(7, 2)
  asi_userid          String            @db.VarChar(150)
  cuentasxasiento     cuentasxasiento[]
}

model asistencia {
  id_asistencia   Int       @id(map: "pk_asistencia") @default(autoincrement())
  id_empleado     Int
  fecha_hora      DateTime  @db.Date
  tipo_movimiento String    @db.VarChar(150)
  empleados       empleados @relation(fields: [id_empleado], references: [id_empleado], onUpdate: Restrict, map: "fk_asistenc_hay_empleado")

  @@index([id_empleado], map: "hay_fk")
}

model bodega {
  id_bodega           Int                   @id(map: "pk_bodega") @default(autoincrement())
  bod_nombre_         String                @db.VarChar(150)
  bod_ubicacion       String                @db.VarChar(150)
  estado_bod          String                @db.VarChar(150)
  ajustes             ajustes[]
  devoluciones_compra devoluciones_compra[]
  devoluciones_ventas devoluciones_ventas[]
  entregas            entregas[]
  inventario_bodegas  inventario_bodegas[]
  percha              percha[]
  recepciones         recepciones[]
}

model cargo {
  id_cargo        Int          @id(map: "pk_cargo") @default(autoincrement())
  id_departamento Int
  car_nombre      String       @db.VarChar(150)
  car_sueldobase  Decimal      @db.Decimal(9, 3)
  car_feccreacion DateTime     @db.Date
  departamento    departamento @relation(fields: [id_departamento], references: [id_departamento], onUpdate: Restrict, map: "fk_cargo_contiene_departam")
  contrato        contrato[]

  @@index([id_departamento], map: "contiene_fk")
}

model categoria {
  id_categoria Int         @id(map: "pk_categoria") @default(autoincrement())
  cat_nombre   String      @db.VarChar(150)
  cat_estado   String      @db.VarChar(150)
  productos    productos[]
}

model categoria_cuenta {
  id_tipocuenta3  String    @id(map: "pk_categoria_cuenta") @db.VarChar(150)
  cat_descripcion String    @db.VarChar(150)
  cuentas         cuentas[]
}

model ciudad {
  id_ciudad     Int           @id(map: "pk_ciudad") @default(autoincrement())
  ciu_nombre    String        @db.VarChar(150)
  ciu_abreviado String        @db.VarChar(150)
  ciu_estado    Boolean
  clientes      clientes[]
  direcciones   direcciones[]
  proveedor     proveedor[]
}

model clientes {
  id_cliente    Int             @id(map: "pk_clientes") @default(autoincrement())
  id_ciudad     Int
  cli_nombre    String          @db.VarChar(150)
  cli_ciruc     String          @db.VarChar(150)
  cli_celular   String          @db.VarChar(150)
  cli_telefono  String          @db.VarChar(150)
  cli_correo    String          @db.VarChar(150)
  cli_categoria Int
  cli_estado    Boolean
  ciudad        ciudad          @relation(fields: [id_ciudad], references: [id_ciudad], onUpdate: Restrict, map: "fk_clientes_pertenece_ciudad")
  direcciones   direcciones[]
  documentos    documentos[]
  interacciones interacciones[]

  @@index([id_ciudad], map: "pertenece3_fk")
}

model colores {
  id_color           Int                  @id(map: "pk_colores") @default(autoincrement())
  col_nombre         String               @db.VarChar(150)
  col_familia        String               @db.VarChar(150)
  col_estado         String               @db.VarChar(150)
  variantes_producto variantes_producto[]
}

model compra {
  id_compra           Int                   @id(map: "pk_compra") @default(autoincrement())
  id_proveedor        Int
  oc_fecha            DateTime              @db.Date
  oc_fechaentrega     DateTime?             @db.Date
  oc_subtotal         Decimal               @db.Decimal(9, 2)
  oc_iva              Decimal               @db.Decimal(2, 0)
  oc_total            Decimal               @db.Decimal(9, 2)
  oc_estado           String                @db.VarChar(150)
  proveedor           proveedor             @relation(fields: [id_proveedor], references: [id_proveedor], onUpdate: Restrict, map: "fk_compra_genera_proveedo")
  devoluciones_compra devoluciones_compra[]
  proxoc              proxoc[]
  recepciones         recepciones[]

  @@index([id_proveedor], map: "genera_fk")
}

model contrato {
  id_contrato         Int          @id(map: "pk_contrato") @default(autoincrement())
  id_empleado         Int
  id_cargo            Int
  con_tipo            String       @db.VarChar(150)
  con_sueldobase      Decimal      @db.Decimal(9, 3)
  con_fechainicio     DateTime     @db.Date
  con_fecha_fin       DateTime?    @db.Date
  con_mensualiza_d3   Boolean
  con_mensualiza_d4   Boolean
  con_mensualiza_fr   Boolean
  con_estado          String       @db.VarChar(150)
  con_empfechaingreso DateTime     @db.Date
  cargo               cargo        @relation(fields: [id_cargo], references: [id_cargo], onUpdate: Restrict, map: "fk_contrato_pertenece_cargo")
  empleados           empleados    @relation(fields: [id_empleado], references: [id_empleado], onUpdate: Restrict, map: "fk_contrato_tiene_empleado")
  meta                meta[]
  vacaciones          vacaciones[]

  @@index([id_cargo], map: "pertenece_fk")
  @@index([id_empleado], map: "tiene_fk")
}

model cuentas {
  id_codigocuenta3 String            @id(map: "pk_cuentas") @db.VarChar(150)
  id_tipocuenta3   String            @db.VarChar(150)
  cue_nombrecuenta String            @db.VarChar(150)
  cue_descripcion  String            @db.VarChar(150)
  cue_tipocuenta   String            @db.VarChar(150)
  cue_deb00        Decimal           @db.Decimal(10, 2)
  cue_deb01        Decimal           @db.Decimal(10, 2)
  cue_deb02        Decimal           @db.Decimal(10, 2)
  cue_deb03        Decimal           @db.Decimal(10, 2)
  cue_deb04        Decimal           @db.Decimal(10, 2)
  cue_deb05        Decimal           @db.Decimal(10, 2)
  cue_deb06        Decimal           @db.Decimal(10, 2)
  cue_deb07        Decimal           @db.Decimal(10, 2)
  cue_deb08        Decimal           @db.Decimal(10, 2)
  cue_deb09        Decimal           @db.Decimal(10, 2)
  cue_deb10        Decimal           @db.Decimal(10, 2)
  cue_deb11        Decimal           @db.Decimal(10, 2)
  cue_deb12        Decimal           @db.Decimal(10, 2)
  cue_deb13        Decimal           @db.Decimal(10, 2)
  cue_hab00        Decimal           @db.Decimal(10, 2)
  cue_hab01        Decimal           @db.Decimal(10, 2)
  cue_hab02        Decimal           @db.Decimal(10, 2)
  cue_hab03        Decimal           @db.Decimal(10, 2)
  cue_hab04        Decimal           @db.Decimal(10, 2)
  cue_hab05        Decimal           @db.Decimal(10, 2)
  cue_hab06        Decimal           @db.Decimal(10, 2)
  cue_hab07        Decimal           @db.Decimal(10, 2)
  cue_hab08        Decimal           @db.Decimal(10, 2)
  cue_hab09        Decimal           @db.Decimal(10, 2)
  cue_hab10        Decimal           @db.Decimal(10, 2)
  cue_hab11        Decimal           @db.Decimal(10, 2)
  cue_hab12        Decimal           @db.Decimal(10, 2)
  cue_hab13        Decimal           @db.Decimal(10, 2)
  cue_userid       String            @db.VarChar(150)
  cue_estadocuenta String            @db.VarChar(150)
  categoria_cuenta categoria_cuenta  @relation(fields: [id_tipocuenta3], references: [id_tipocuenta3], onUpdate: Restrict, map: "fk_cuentas_dispone_categori")
  cuentasxasiento  cuentasxasiento[]

  @@index([id_tipocuenta3], map: "dispone_fk")
}

model cuentasxasiento {
  id_codigocuenta3    String   @db.VarChar(150)
  id_asientocontable3 String   @db.VarChar(150)
  cxa_montodebe       Decimal  @db.Decimal(10, 2)
  cxa_montohaber      Decimal  @db.Decimal(10, 2)
  cxa_descripcion     String   @db.VarChar(150)
  cxa_estadocxa       String   @db.VarChar(150)
  asientos            asientos @relation(fields: [id_asientocontable3], references: [id_asientocontable3], onUpdate: Restrict, map: "fk_cuentasx_cuentasxa_asientos")
  cuentas             cuentas  @relation(fields: [id_codigocuenta3], references: [id_codigocuenta3], onUpdate: Restrict, map: "fk_cuentasx_cuentasxa_cuentas")

  @@id([id_codigocuenta3, id_asientocontable3], map: "pk_cuentasxasiento")
  @@index([id_asientocontable3], map: "cuentasxasiento2_fk")
  @@index([id_codigocuenta3], map: "cuentasxasiento_fk")
}

model cuotas {
  id_cuota           Int         @id(map: "pk_cuotas") @default(autoincrement())
  id_documento       Int?
  cuo_numero         Int
  cuo_monto          Decimal     @db.Decimal(10, 2)
  cuo_pendiente      Decimal     @db.Decimal(10, 2)
  cuo_fecha_pagado   DateTime?   @db.Date
  cuo_fecha_estimada DateTime    @db.Date
  cuo_estado         String      @db.VarChar(150)
  documentos         documentos? @relation(fields: [id_documento], references: [id_documento], onDelete: Restrict, onUpdate: Restrict, map: "fk_cuotas_generan_document")

  @@index([id_documento], map: "generan_fk")
}

model departamento {
  id_departamento Int      @id(map: "pk_departamento") @default(autoincrement())
  dep_nombre      String   @db.VarChar(150)
  dep_estado      String   @db.VarChar(150)
  dep_feccreacion DateTime @db.Date
  cargo           cargo[]
}

model dependientes {
  id_dependiente      Int       @id(map: "pk_dependientes") @default(autoincrement())
  id_empleado         Int
  dep_ceddoc          Decimal   @db.Decimal(10, 0)
  dep_nom1            String    @db.VarChar(150)
  dep_nom2            String?   @db.VarChar(150)
  dep_ap1             String    @db.VarChar(150)
  dep_ap2             String    @db.VarChar(150)
  dep_fechanacimiento DateTime  @db.Date
  dep_sexo            String    @db.VarChar(150)
  dep_parentesco      String    @db.VarChar(150)
  dep_estado          String    @db.VarChar(150)
  empleados           empleados @relation(fields: [id_empleado], references: [id_empleado], onUpdate: Restrict, map: "fk_dependie_mantiene2_empleado")

  @@index([id_empleado], map: "mantiene2_fk")
}

model detallehorario {
  id_detalle       Int       @id(map: "pk_detallehorario") @default(autoincrement())
  id_horario       Int
  det_dia_semana   String?   @db.VarChar(150)
  det_hora_entrada DateTime? @db.Date
  det_hora_salida  DateTime? @db.Date
  horario          horario   @relation(fields: [id_horario], references: [id_horario], onUpdate: Restrict, map: "fk_detalleh_tien_horario")

  @@index([id_horario], map: "tien_fk")
}

model devoluciones_compra {
  id_devcompra_pk      Int        @id(map: "pk_devoluciones_compra") @default(autoincrement())
  id_compra            Int
  id_bodega            Int
  devc_fechahora       DateTime   @db.Date
  devc_motivo          String     @db.VarChar(150)
  devc_num_produc      Int
  devc_fecharesolucion DateTime?  @db.Date
  usu_responsable      String     @db.VarChar(150)
  devc_estado          String     @db.VarChar(150)
  compra               compra     @relation(fields: [id_compra], references: [id_compra], onUpdate: Restrict, map: "fk_devoluci_crea_compra")
  bodega               bodega     @relation(fields: [id_bodega], references: [id_bodega], onUpdate: Restrict, map: "fk_devoluci_maneja_bodega")
  proxdevc             proxdevc[]

  @@index([id_compra], map: "crea_fk")
  @@index([id_bodega], map: "maneja_fk")
}

model devoluciones_ventas {
  id_devolucion       Int         @id(map: "pk_devoluciones_ventas") @default(autoincrement())
  id_bodega           Int
  id_documento        Int
  dev_fechahora       DateTime    @db.Date
  dev_motivo          String      @db.VarChar(150)
  dev_num_produc      Int
  dev_fecharesolucion DateTime?   @db.Date
  usu_responsable     String      @db.VarChar(150)
  estado_dev          String      @db.VarChar(150)
  documentos          documentos  @relation(fields: [id_documento], references: [id_documento], onUpdate: Restrict, map: "fk_devoluci_asocia_document")
  bodega              bodega      @relation(fields: [id_bodega], references: [id_bodega], onUpdate: Restrict, map: "fk_devoluci_sufre_bodega")
  proxdeven           proxdeven[]

  @@index([id_documento], map: "asocia_fk")
  @@index([id_bodega], map: "sufre_fk")
}

model direcciones {
  id_direccion   Int         @id(map: "pk_direcciones") @default(autoincrement())
  id_ciudad      Int
  id_cliente     Int
  dir_sector     String      @db.VarChar(150)
  dir_principal  String      @db.VarChar(150)
  dir_secundaria String?     @db.VarChar(150)
  dir_referencia String      @db.VarChar(150)
  dir_estado     Boolean
  ciudad         ciudad      @relation(fields: [id_ciudad], references: [id_ciudad], onUpdate: Restrict, map: "fk_direccio_radica_ciudad")
  clientes       clientes    @relation(fields: [id_cliente], references: [id_cliente], onUpdate: Restrict, map: "fk_direccio_reside_clientes")
  logistica      logistica[]

  @@index([id_ciudad], map: "radica_fk")
  @@index([id_cliente], map: "reside_fk")
}

model documentos {
  id_documento        Int                   @id(map: "pk_documentos") @default(autoincrement())
  id_cliente          Int
  doc_id_documento    Int?
  id_vendedor         Int
  doc_tipo            String                @db.VarChar(150)
  doc_emision         DateTime              @db.Date
  doc_pago            DateTime?             @db.Date
  doc_descripcion     String                @db.VarChar(150)
  doc_subtotal        Decimal               @db.Decimal(12, 4)
  doc_iva             Decimal               @db.Decimal(12, 4)
  doc_descuento       Decimal               @db.Decimal(12, 4)
  doc_total           Decimal               @db.Decimal(12, 4)
  doc_estado          String                @db.VarChar(150)
  cuotas              cuotas[]
  devoluciones_ventas devoluciones_ventas[]
  vendedores          vendedores            @relation(fields: [id_vendedor], references: [id_vendedor], onUpdate: Restrict, map: "fk_document_crea2_vendedor")
  documentos          documentos?           @relation("documentosTodocumentos", fields: [doc_id_documento], references: [id_documento], onDelete: Restrict, onUpdate: Restrict, map: "fk_document_refiere_document")
  other_documentos    documentos[]          @relation("documentosTodocumentos")
  clientes            clientes              @relation(fields: [id_cliente], references: [id_cliente], onUpdate: Restrict, map: "fk_document_registra_clientes")
  documentoxpago      documentoxpago[]
  entregas            entregas[]
  interacciones       interacciones[]
  logistica           logistica[]
  productosxdocumento productosxdocumento[]

  @@index([id_vendedor], map: "crea2_fk")
  @@index([doc_id_documento], map: "refiere_fk")
  @@index([id_cliente], map: "registra_fk")
}

model documentoxpago {
  id_documento       Int
  id_metodopago      Int
  dxp_monto_aboonado Decimal     @db.Decimal(10, 2)
  dxp_referencia     String?     @db.VarChar(150)
  dxp_mesesplazo     Int?
  documentos         documentos  @relation(fields: [id_documento], references: [id_documento], onUpdate: Restrict, map: "fk_document_documento_document")
  metodospago        metodospago @relation(fields: [id_metodopago], references: [id_metodopago], onUpdate: Restrict, map: "fk_document_documento_metodosp")

  @@id([id_documento, id_metodopago], map: "pk_documentoxpago")
  @@index([id_metodopago], map: "documentoxpago2_fk")
  @@index([id_documento], map: "documentoxpago_fk")
}

model empleados {
  id_empleado         Int                @id(map: "pk_empleados") @default(autoincrement())
  emp_cedula          String             @db.VarChar(150)
  emp_nom1            String             @db.VarChar(150)
  emp_nom2            String?            @db.VarChar(150)
  emp_ap1             String             @db.VarChar(150)
  emp_ap2             String?            @db.VarChar(150)
  emp_sexo            String             @db.VarChar(150)
  emp_fechanacimiento DateTime           @db.Date
  emp_email           String             @db.VarChar(150)
  emp_direccion       String             @db.VarChar(150)
  emp_telefono        String             @db.VarChar(150)
  asistencia          asistencia[]
  contrato            contrato[]
  dependientes        dependientes[]
  horarioxempleado    horarioxempleado[]
  permisos            permisos[]
  rolpagos            rolpagos[]
  usuarios            usuarios[]
  vendedores          vendedores[]
}

model entregas {
  id_entrega           Int        @id(map: "pk_entregas") @default(autoincrement())
  id_documento         Int
  id_bodega            Int
  ent_fechahora_       DateTime   @db.Date
  ent_descripcion      String     @db.VarChar(150)
  ent_num_produc       Int
  ent_fecharesolucion_ DateTime?  @db.Date
  usu_responsable      String     @db.VarChar(150)
  ent_estado           String     @db.VarChar(150)
  bodega               bodega     @relation(fields: [id_bodega], references: [id_bodega], onUpdate: Restrict, map: "fk_entregas_entrega_e_bodega")
  documentos           documentos @relation(fields: [id_documento], references: [id_documento], onUpdate: Restrict, map: "fk_entregas_gestiona_document")
  proxent              proxent[]

  @@index([id_bodega], map: "entrega_en_fk")
  @@index([id_documento], map: "gestiona_fk")
}

model horario {
  id_horario         Int                @id(map: "pk_horario") @default(autoincrement())
  hor_nombre_horario String             @db.VarChar(150)
  hor_horastotal     Int
  detallehorario     detallehorario[]
  horarioxempleado   horarioxempleado[]
}

model horarioxempleado {
  id_horario              Int
  id_empleado             Int
  fecha_inicio_asignacion DateTime  @db.Date
  fecha_fin_asignacion    DateTime? @db.Date
  empleados               empleados @relation(fields: [id_empleado], references: [id_empleado], onUpdate: Restrict, map: "fk_horariox_horarioxe_empleado")
  horario                 horario   @relation(fields: [id_horario], references: [id_horario], onUpdate: Restrict, map: "fk_horariox_horarioxe_horario")

  @@id([id_horario, id_empleado], map: "pk_horarioxempleado")
  @@index([id_empleado], map: "horarioxempleado2_fk")
  @@index([id_horario], map: "horarioxempleado_fk")
}

model interacciones {
  id_interaccion    Int        @id(map: "pk_interacciones") @default(autoincrement())
  id_cliente        Int
  id_documento      Int
  int_tipo          String     @db.VarChar(150)
  int_canal         String     @db.VarChar(150)
  int_inconveniente String     @db.VarChar(150)
  int_apertura      DateTime   @db.Date
  int_cierre        DateTime?  @db.Date
  int_estado        String     @db.VarChar(150)
  clientes          clientes   @relation(fields: [id_cliente], references: [id_cliente], onUpdate: Restrict, map: "fk_interacc_realiza_clientes")
  documentos        documentos @relation(fields: [id_documento], references: [id_documento], onUpdate: Restrict, map: "fk_interacc_referenci_document")

  @@index([id_cliente], map: "realiza_fk")
  @@index([id_documento], map: "referencia_fk")
}

model inventario_bodegas {
  id_bodega          Int
  id_variante        Int
  inv_periodo        String             @db.VarChar(150)
  inv_saldo_inicial  Int
  inv_qty_ingresos   Int
  inv_qty_egresos    Int
  inv_qty_ajustes    Int
  inv_saldo_final    Int
  bodega             bodega             @relation(fields: [id_bodega], references: [id_bodega], onUpdate: Restrict, map: "fk_inventar_inventari_bodega")
  variantes_producto variantes_producto @relation(fields: [id_variante], references: [id_variante], onUpdate: Restrict, map: "fk_inventar_inventari_variante")

  @@id([id_bodega, id_variante, inv_periodo], map: "pk_inventario_bodegas")
  @@index([id_bodega], map: "inventario_bodegas2_fk")
  @@index([id_variante], map: "inventario_bodegas_fk")
}

model logistica {
  id_logistica        Int                   @id(map: "pk_logistica") @default(autoincrement())
  id_direccion        Int
  id_documento        Int
  log_despacho        DateTime              @db.Date
  log_estimada        DateTime              @db.Date
  log_real            DateTime?             @db.Date
  log_estado          String                @db.VarChar(150)
  direcciones         direcciones           @relation(fields: [id_direccion], references: [id_direccion], onUpdate: Restrict, map: "fk_logistic_despacha_direccio")
  documentos          documentos            @relation(fields: [id_documento], references: [id_documento], onUpdate: Restrict, map: "fk_logistic_entrega_document")
  productosxlogistica productosxlogistica[]

  @@index([id_direccion], map: "despacha_fk")
  @@index([id_documento], map: "entrega_fk")
}

model marcas {
  id_marca   Int         @id(map: "pk_marcas") @default(autoincrement())
  mar_nombre String      @db.VarChar(150)
  mar_estado String      @db.VarChar(150)
  productos  productos[]
}

model materiales {
  id_material  Int         @id(map: "pk_materiales") @default(autoincrement())
  mat_nombre   String      @db.VarChar(150)
  mat_cuidados String      @db.VarChar(150)
  mat_estado   String      @db.VarChar(150)
  productos    productos[]
}

model meta {
  id_meta         Int       @id(map: "pk_meta") @default(autoincrement())
  id_rolpago2     String?   @db.VarChar(150)
